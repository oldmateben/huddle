{
  "name": "huddle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & wrangler dev",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply huddle --local",
    "db:migrate": "wrangler d1 migrations apply huddle --remote",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  }
}